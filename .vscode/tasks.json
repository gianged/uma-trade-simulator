// Generated by s-launch ahead of the workspace. Compose file assumed at docker/compose.yaml.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build workspace",
      "type": "cargo",
      "command": "build",
      "args": ["--workspace"],
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "compose: up infra",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "-f", "docker/compose.yaml", "up", "-d", "postgres"],
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "compose: down",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "-f", "docker/compose.yaml", "down"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "prepare: infra + build",
      "dependsOn": ["compose: up infra", "cargo: build workspace"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "rr: record binary",
      "type": "shell",
      "command": "rr",
      "args": ["record", "${workspaceFolder}/target/debug/${input:rrBinaryName}"],
      "presentation": { "reveal": "always", "panel": "new", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "rr: start replay server",
      "type": "shell",
      "command": "rr",
      "args": ["replay", "-s", "50505", "-k"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "new", "clear": false },
      "problemMatcher": []
    }
    // "Run rest, debug one": add a cargo run task per service, e.g.
    //   { "label": "run: loadgen", "type": "cargo", "command": "run",
    //     "args": ["--bin", "loadgen"], "isBackground": true,
    //     "presentation": { "panel": "dedicated" }, "problemMatcher": [] }
    // then a "run: all except engine" task with dependsOn + "dependsOrder": "parallel",
    // and use it as preLaunchTask on "Debug bin: engine".
  ],
  "inputs": [
    {
      "id": "rrBinaryName",
      "type": "pickString",
      "description": "Binary in target/debug/ to record",
      "options": ["engine", "loadgen", "session", "persister", "gateway", "swarm"],
      "default": "engine"
    }
  ]
}
