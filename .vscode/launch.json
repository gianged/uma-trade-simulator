    // 3-Time travel (Linux x86_64 only; flaky under WSL2, needs unvirtualized perf counters)
    //   1. rr check
    //   2. Task "rr: record binary" -> enter engine or loadgen
    //   3. Task "rr: start replay server" (port 50505, keeps running)
    //   4. F5 with the matching Replay config
    // Reverse ops in Debug Console: process reverse-continue, thread step-over -r
    {
      "type": "lldb",
      "request": "attach",
      "name": "Replay (rr): engine",
      "targetCreateCommands": ["target create ${workspaceFolder}/target/debug/engine"],
      "processCreateCommands": ["gdb-remote 127.0.0.1:50505"],
      "reverseDebugging": true,
      "presentation": { "group": "3-Time travel", "order": 1 }
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "Replay (rr): loadgen",
      "targetCreateCommands": ["target create ${workspaceFolder}/target/debug/loadgen"],
      "processCreateCommands": ["gdb-remote 127.0.0.1:50505"],
      "reverseDebugging": true,
      "presentation": { "group": "3-Time travel", "order": 2 }
    },

    // 6-Attach
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach to engine (pick PID)",
      "program": "${workspaceFolder}/target/debug/engine",
      "pid": "${command:pickProcess}",
      "presentation": { "group": "6-Attach", "order": 1 }
    },
    // Engine inside its budget container. Container needs cap_add: SYS_PTRACE and
    // security_opt: seccomp:unconfined; start it as: gdbserver "*:2345" /app/engine
    // sourceMap: "/app" must match the Dockerfile WORKDIR the binary was built in.
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach to engine (container, gdbserver :2345)",
      "targetCreateCommands": ["target create ${workspaceFolder}/target/debug/engine"],
      "processCreateCommands": ["gdb-remote 127.0.0.1:2345"],
      "sourceMap": { "/app": "${workspaceFolder}" },
      "presentation": { "group": "6-Attach", "order": 2 }
    }
  ],
  "compounds": [
    {
      "name": "Debug All Services",
      "configurations": [
